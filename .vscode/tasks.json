{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: clang++ build active file",
            "command": "/bin/zsh",
            "args": [
                "-c",
                "mkdir -p '${workspaceFolder}/build' && /usr/bin/clang++ -std=c++17 '${file}' -o '${workspaceFolder}/build/${fileBasenameNoExtension}'"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        }
    ]
}